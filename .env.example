# =====================================================================
# Netlify Database (PostgreSQL)
# ---------------------------------------------------------------------
# Buat database di Netlify: Data & Storage -> Database.
# NETLIFY_DB_URL tersedia otomatis pada deploy dan melalui `netlify dev`.
# Jangan menyalin connection string ini ke variabel yang diekspos ke browser.
# =====================================================================
NETLIFY_DB_URL=""

# =====================================================================
# WhatsApp Gateway (notifikasi otomatis)
# ---------------------------------------------------------------------
# API key device dari WA Gateway (Authorization: Bearer).
# Jika kosong, notifikasi otomatis dilewati dan pendaftaran tetap berjalan.
# =====================================================================
WA_API_KEY=""
